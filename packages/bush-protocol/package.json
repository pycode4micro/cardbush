{
  "name": "@cardbush/bush-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conversational-subagent-tools": {
      "types": "./dist/conversationalSubagentTools.d.cts",
      "default": "./dist/conversationalSubagentTools.cjs"
    },
    "./runtime-fixture": {
      "types": "./dist/runtimeFixture.d.ts",
      "import": "./dist/runtimeFixture.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "license": "Apache-2.0"
}
