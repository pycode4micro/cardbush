{
  "name": "@cardbush/bush-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./workspace-edit-recovery": {
      "types": "./dist/workspaceEditRecovery.d.ts",
      "import": "./dist/workspaceEditRecovery.js"
    },
    "./processes": {
      "types": "./dist/processes.d.ts",
      "import": "./dist/processes.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workspace-diff": {
      "types": "./dist/workspaceDiff.d.ts",
      "import": "./dist/workspaceDiff.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-process-resource-host.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@cardbush/bush-protocol": "^0.1.0",
    "js-yaml": "4.3.2",
    "sharp": "0.35.4",
    "@cardbush/platform": "0.1.0"
  },
  "license": "Apache-2.0"
}
