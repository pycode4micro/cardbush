{
  "name": "@cardbush/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist-cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./credentials": {
      "types": "./dist-cjs/credentials.d.ts",
      "default": "./dist-cjs/credentials.js"
    },
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist-cjs/index.d.ts",
        "default": "./dist-cjs/index.js"
      }
    },
    "./i18n": {
      "import": {
        "types": "./dist/i18n/index.d.ts",
        "default": "./dist/i18n/index.js"
      },
      "require": {
        "types": "./dist-cjs/i18n/index.d.ts",
        "default": "./dist-cjs/i18n/index.js"
      }
    },
    "./contracts": {
      "import": {
        "types": "./dist/contracts.d.ts",
        "default": "./dist/contracts.js"
      },
      "require": {
        "types": "./dist-cjs/contracts.d.ts",
        "default": "./dist-cjs/contracts.js"
      }
    },
    "./templates": {
      "import": {
        "types": "./dist/templates/index.d.ts",
        "default": "./dist/templates/index.js"
      },
      "require": {
        "types": "./dist-cjs/templates/index.d.ts",
        "default": "./dist-cjs/templates/index.js"
      }
    },
    "./prompts": {
      "import": {
        "types": "./dist/prompts/index.d.ts",
        "default": "./dist/prompts/index.js"
      },
      "require": {
        "types": "./dist-cjs/prompts/index.d.ts",
        "default": "./dist-cjs/prompts/index.js"
      }
    }
  },
  "files": [
    "dist",
    "dist-cjs"
  ],
  "scripts": {
    "build": "node ../../scripts/build-ui-language-packs.mjs && node ../../scripts/build-html-templates.mjs && node ../../scripts/build-prompt-templates.mjs && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/finalize.cjs",
    "test": "node --test test/*.test.mjs"
  }
}
