+      {!multi && <button type="submit" disabled={busy || !text.trim()} aria-label={uiText(language)('solutionSelectionCard.submitSolution')}>{busy ? <LoaderCircle size={16} className="spin"/> : <ArrowUp size={16}/>}</button>}
+    </form>
