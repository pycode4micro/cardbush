@@ -0,0 +1,9 @@
+import type { ToolCall } from '@cardbush/bush-protocol';
+
+/** Preserve receipt ordinals while deferring final user output until work settles.
+ * Final-display signals do not change the identity of the original calls. */
+export function toolExecutionPhases(calls: ToolCall[]): number[][] {
+  const work: number[] = [], summaries: number[] = [];
+  calls.forEach((call, ordinal) => (call.name === 'summary_for_user' ? summaries : work).push(ordinal));
+  return [work, summaries].filter(phase => phase.length);
+}
