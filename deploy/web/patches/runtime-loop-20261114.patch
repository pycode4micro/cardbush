+const temporary = () => mkdtempSync(join(tmpdir(), 'assistant-conversation-'));
+const entry = (key, content = '请帮我检查文件', role = 'user', source = 'text') => ({ id: key, content, role, source, visibility: 'conversation', createdAt: new Date().toISOString() });
