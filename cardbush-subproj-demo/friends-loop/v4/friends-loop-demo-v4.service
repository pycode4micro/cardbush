[Unit]
Description=Friends isolated event-loop demonstration
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/friends-loop-demo-20261104/v4
ExecStart=/usr/local/bin/node /opt/friends-loop-demo-20261104/v4/main.mjs serve /opt/friends-loop-demo-20261104/v4/runs/nba-01
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
Nice=10
UMask=0077
NoNewPrivileges=true
MemoryMax=512M
StandardOutput=append:/opt/friends-loop-demo-20261104/v4/runs/nba-01/service.log
StandardError=append:/opt/friends-loop-demo-20261104/v4/runs/nba-01/service.log

[Install]
WantedBy=multi-user.target
