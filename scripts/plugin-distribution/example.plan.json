      "server": "example",
      "args": ["${PLUGIN_ROOT}/server.py"],
      "python": {
        "base": "C:/build-tools/Python312",
        "site": "C:/build-tools/example-venv/Lib/site-packages",
        "requirements": ["mcp>=1.28,<2"]
      }
    }
  ]
}
