{
  "mcpServers": {
    "documents": {
      "cardbush_file_operations": {
        "inspect_document": { "execution": "file", "paths": [{ "argument": "path", "access": "read", "kind": "path" }] },
        "author_document": { "execution": "host_code", "paths": [
          { "argument": "inputs", "access": "read", "kind": "entries", "property": "path" },
          { "argument": "outputs", "access": "write", "kind": "paths" }
        ] },
        "convert_document": { "execution": "file", "paths": [
          { "argument": "path", "access": "read", "kind": "path" },
          { "argument": "output", "access": "write", "kind": "path" }
        ] },
        "render_presentation": { "execution": "file", "paths": [
          { "argument": "path", "access": "read", "kind": "path" },
          { "argument": "output", "access": "write", "kind": "path" }
        ] }
      },
      "cardbush_attachment_readers": {
        "inspect_document": {
          "pathArgument": "path",
          "readArguments": ["expected_sha256", "sheet", "offset", "limit", "start_column"]
        }
      },
      "tool_timeout_sec": 150,
      "env": {
        "ELECTRON_RUN_AS_NODE": "1",
        "CARDBUSH_SOFFICE": "${CARDBUSH_SOFFICE:-}",
        "SOFFICE_PATH": "${SOFFICE_PATH:-}"
      },
      "type": "stdio",
      "command": "${CARDBUSH_NODE_EXECUTABLE}",
      "args": [
        "${PLUGIN_ROOT}/server.cjs"
      ],
      "cwd": "${PLUGIN_DATA}"
    }
  }
}
