{
  "manifest_version": 3,
  "name": "CardBush Browser Use",
  "version": "1.2.3",
  "minimum_chrome_version": "116",
  "description": "Connect Chrome or Edge to Browser Use on Windows 11. Control only authorized tabs in each CardBush session group.",
  "key": "",
  "icons": {
    "16": "icons/cardbush-16.png",
    "32": "icons/cardbush-32.png",
    "48": "icons/cardbush-48.png",
    "128": "icons/cardbush-128.png"
  },
  "permissions": [
    "alarms",
    "debugger",
    "downloads",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:*"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CardBush Browser Use",
    "default_icon": {
      "16": "icons/cardbush-16.png",
      "32": "icons/cardbush-32.png",
      "48": "icons/cardbush-48.png",
      "128": "icons/cardbush-128.png"
    },
    "default_popup": "popup.html"
  }
}
