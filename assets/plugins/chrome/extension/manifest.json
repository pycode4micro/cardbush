{
  "manifest_version": 3,
  "name": "CardBush Browser Connector",
  "version": "1.0.1",
  "minimum_chrome_version": "102",
  "description": "Isolate each CardBush session in a named Chrome tab group and control only tabs you explicitly add.",
  "key": "",
  "icons": {
    "16": "icons/cardbush-16.png",
    "32": "icons/cardbush-32.png",
    "48": "icons/cardbush-48.png",
    "128": "icons/cardbush-128.png"
  },
  "permissions": [
    "alarms",
    "debugger",
    "nativeMessaging",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CardBush Browser Connector",
    "default_icon": {
      "16": "icons/cardbush-16.png",
      "32": "icons/cardbush-32.png",
      "48": "icons/cardbush-48.png",
      "128": "icons/cardbush-128.png"
    },
    "default_popup": "popup.html"
  }
}
