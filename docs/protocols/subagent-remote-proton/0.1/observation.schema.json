{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contextId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "cursor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "working",
        "input_required",
        "completed",
        "failed",
        "canceled",
        "interrupted"
      ]
    },
    "progress": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "text": {
          "type": "string",
          "maxLength": 1000
        },
        "completedActions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failedActions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "phase",
        "text",
        "completedActions",
        "failedActions"
      ],
      "additionalProperties": false
    },
    "interactions": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "contextId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "taskId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "interactionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "kind": {
                "type": "string",
                "const": "question"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000
              },
              "suggestions": {
                "default": [],
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "blocking": {
                "type": "boolean"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              }
            },
            "required": [
              "contextId",
              "taskId",
              "interactionId",
              "kind",
              "text",
              "blocking",
              "createdAt"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "contextId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "taskId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "interactionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "kind": {
                "type": "string",
                "const": "permission"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000
              },
              "actionDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "operations": {
                "minItems": 1,
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              },
              "resources": {
                "minItems": 1,
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16000
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "authority": {
                "type": "string",
                "enum": [
                  "parent_delegate",
                  "human_required"
                ]
              },
              "decisions": {
                "minItems": 1,
                "maxItems": 2,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "allow_once",
                    "deny"
                  ]
                }
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              }
            },
            "required": [
              "contextId",
              "taskId",
              "interactionId",
              "kind",
              "text",
              "actionDigest",
              "operations",
              "resources",
              "authority",
              "decisions",
              "createdAt"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "contextId",
    "taskId",
    "cursor",
    "state",
    "progress",
    "interactions"
  ],
  "additionalProperties": false
}
