{
  "name": "cardbush-electron",
  "version": "1.0.0-dev",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "postinstall": "node scripts/install-electron.mjs",
    "predev": "node scripts/free-dev-port.mjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.node.json --watch --preserveWatchOutput\" \"wait-on http://127.0.0.1:5173 dist-electron/main.js && node scripts/run-electron-dev.mjs\"",
    "prebuild": "npm run build:runtime",
    "build": "tsc -p tsconfig.node.json && vite build",
    "build:runtime": "npm run build --workspace @cardbush/bush-protocol && npm run build --workspace @cardbush/bush-runtime && npm run build --workspace @cardbush/bush-product-agent && npm run build --workspace @cardbush/product-host && npm run build --workspace @cardbush/bush-provider-openai && npm run build --workspace @cardbush/bush-mcp-client && npm run build --workspace @cardbush/bush-runtime-electron",
    "gui": "npm run build && node scripts/run-electron-gui.mjs",
    "icon:generate": "electron scripts/generate-cardbush-icon.cjs",
    "fix:electron": "node scripts/install-electron.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:path-metadata": "node scripts/test-local-path-metadata.mjs",
    "test:markdown": "node scripts/test-markdown-format.mjs",
    "test:skill-selection": "node scripts/test-skill-selection-metadata.mjs",
    "test:skill-icons": "node scripts/test-skill-icons-contract.mjs",
    "test:product-skills": "tsc -p tsconfig.node.json && node scripts/test-product-skills-contract.mjs",
    "test:task-plan": "node scripts/test-task-plan-contract.mjs",
    "test:turn-guidance": "node scripts/test-turn-guidance-contract.mjs",
    "test:composer-actions": "node scripts/test-composer-quick-actions-contract.mjs",
    "test:panel-motion": "node scripts/test-panel-motion-contract.mjs",
    "test:settings-layout": "node scripts/test-settings-layout-contract.mjs",
    "test:os-theme": "node scripts/test-os-theme-contract.mjs",
    "test:session-attention": "node scripts/test-session-attention-contract.mjs",
    "test:release-cleanup": "node scripts/test-release-cleanup-contract.mjs",
    "test:office-preview": "node scripts/test-office-preview-contract.mjs",
    "test:model-selection": "node scripts/test-model-selection-contract.mjs",
    "test:message-edit": "node scripts/test-message-edit-contract.mjs",
    "test:history-tools": "node scripts/test-history-tool-contract.mjs",
    "test:assistant-timing": "node scripts/test-assistant-timing-contract.mjs",
    "test:message-media": "node scripts/test-message-media-contract.mjs",
    "test:tool-media-artifacts": "node scripts/test-tool-media-artifacts-contract.mjs",
    "test:chat-scroll": "node scripts/test-chat-scroll-contract.mjs",
    "test:sidebar-interaction": "node scripts/test-sidebar-interaction-contract.mjs",
    "test:conversation-workspace": "node scripts/test-conversation-workspace-contract.mjs",
    "test:goal-a2a": "node scripts/test-goal-a2a-contract.mjs",
    "test:goal-command": "node scripts/test-goal-command-contract.mjs",
    "test:product-a2a": "tsc -p tsconfig.node.json && node scripts/test-product-a2a-contract.mjs",
    "test:desktop-action": "node scripts/test-desktop-action-contract.mjs",
    "test:capability-candidates": "node scripts/test-capability-candidates-contract.mjs",
    "test:subagent-observability": "node scripts/test-subagent-observability-contract.mjs",
    "test:team-configuration": "node scripts/test-team-configuration-contract.mjs",
    "test:runtime-asset-reset": "node scripts/test-runtime-asset-reset-contract.mjs",
    "test:llm-timeouts": "node scripts/test-llm-timeout-contract.mjs",
    "test:connection-recovery": "node scripts/test-connection-recovery-contract.mjs",
    "test:session-runtime": "node scripts/test-session-runtime-contract.mjs",
    "test:stop-lifecycle": "node scripts/test-stop-lifecycle-contract.mjs",
    "test:project-roots": "node scripts/test-project-root-contract.mjs",
    "test:tool-visibility": "node scripts/test-tool-visibility.mjs",
    "test:cardbush-app-host": "node scripts/test-cardbush-app-host-contract.mjs",
    "test:runtime": "npm run build:runtime && npm run test:unit --workspace @cardbush/bush-protocol && npm run test:unit --workspace @cardbush/bush-runtime && npm run test --workspace @cardbush/bush-product-agent && npm run test:unit --workspace @cardbush/bush-provider-openai && npm run test:unit --workspace @cardbush/bush-mcp-client && npm run test:unit --workspace @cardbush/bush-runtime-electron",
    "test:runtime-utility": "npm run build:runtime && tsc -p tsconfig.node.json && electron scripts/test-runtime-utility-host.cjs",
    "typecheck:runtime": "npm run typecheck --workspace @cardbush/bush-protocol && npm run typecheck --workspace @cardbush/bush-runtime && npm run typecheck --workspace @cardbush/bush-provider-openai && npm run typecheck --workspace @cardbush/bush-mcp-client && npm run typecheck --workspace @cardbush/bush-runtime-electron",
    "pretypecheck": "npm run build:runtime",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test:all": "node scripts/run-release-checks.mjs"
  },
  "dependencies": {
    "@jvmr/pptx-to-html": "^1.1.1",
    "@xterm/xterm": "^6.0.0",
    "docx-preview": "^0.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.7",
    "remark-gfm": "^4.0.1",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.4",
    "electron": "^42.8.1",
    "resedit": "^3.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "wait-on": "^9.0.10"
  }
}
